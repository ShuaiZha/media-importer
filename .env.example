# 所有账号和 ID 均为示例，首次部署必须替换；相机自动发现，SMB 共享需提前创建。
# 复制为 .env；单引号保留空格、$、# 等字面字符。不要提交真实 .env。
# 连接修改：原生执行 media-importer stop 后 start；Docker 重建容器。
# 相对路径以项目目录为基准；原生改目录需重新登记，Docker 挂载目录需提前创建。
# 生效方式、目录迁移和全部字段说明见 docs/configuration.md。
MEDIA_IMPORTER_CONFIG_HOST_DIR='./config'
MEDIA_IMPORTER_DATA_HOST_DIR='./data'
MEDIA_IMPORTER_CACHE_HOST_DIR='./data/cache'
# Mac 外接盘示例：'/Volumes/MediaSSD/media-importer/cache'
# Windows 示例：'D:/MediaImport/cache'

# 来源适配：当前已接入 GoPro USB；具体机型与固件见 docs/compatibility.md。
SOURCE_TYPE='gopro'
# 可留空自动发现。已有值作为优先探测提示，实际设备以飞书本次确认结果为准。
# 如需手动提示，URL 填相机 HTTP 根地址（含 :8080），不是电脑 USB 网卡地址。
SOURCE_URL=''
SOURCE_SERIAL=''
SOURCE_TIMEOUT_SECONDS=20
SOURCE_REQUEST_ATTEMPTS=3

# 目的地适配：当前已接入 SMB，可使用 NAS、电脑共享或其他 SMB 服务器。
DESTINATION_TYPE='smb'
DESTINATION_NAME='SMB 存储'
# IP 或域名，不带 smb://、端口和路径；远程访问先在宿主机接通 VPN。
DESTINATION_HOST='storage.example.com'
DESTINATION_PORT=445
# 对应 smb://storage.example.com/media/imports；共享与 imports 子目录须已存在。
DESTINATION_SHARE='media'
DESTINATION_DIRECTORY='imports'
DESTINATION_USERNAME='backup'
DESTINATION_PASSWORD='REPLACE_WITH_SMB_PASSWORD'
# 无 Windows 域的服务器通常使用 WORKGROUP；按服务器认证要求填写。
DESTINATION_DOMAIN='WORKGROUP'

# 企业自建应用机器人，不使用群机器人 Webhook；完整步骤见 docs/feishu.md。
FEISHU_APP_ID='cli_EXAMPLE00000000'
FEISHU_APP_SECRET='REPLACE_WITH_APP_SECRET'
# 只接受此人在当前应用中的单聊命令和卡片操作，通知也发给此人。
# 必须在上述 App ID 下获取本人 Open ID，不能使用 user_id 或其他应用的 Open ID。
FEISHU_OWNER_OPEN_ID='ou_EXAMPLE00000000'
